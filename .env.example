# Copia este archivo a .env para desarrollo local. El .env real nunca se sube.

# Postgres. Local: contenedor de podman/docker (ver README). Producción: cadena "pooled" de Neon.
DATABASE_URL=postgres://duam:duam@localhost:5433/duam
# (Opcional) conexión directa sin pooler para migraciones y seed en Neon.
# DATABASE_URL_UNPOOLED=

# Firma de los JWT: mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-48-bytes
# Duración del token (formato jsonwebtoken: 2h, 7d, 3600…)
JWT_EXPIRES_IN=2h

# Orígenes permitidos por CORS (URL del frontend), separados por coma. Nunca "*".
CORS_ORIGINS=http://localhost:3000

PORT=4000
