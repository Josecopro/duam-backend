# Copia este archivo a .env para desarrollo local.

# Postgres local (podman/docker, ver README) o la cadena "pooled" de Neon.
DATABASE_URL=postgres://duam:duam@localhost:5433/duam

# Clave compartida con el frontend para las escrituras (POST /api/pqrs).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=cambia-esta-clave

PORT=4000
